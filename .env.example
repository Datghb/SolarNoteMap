AI_PROVIDER=groq
AI_MODEL=qwen/qwen3.6-27b

# Chỉ cần điền key của provider đang chọn.
OPENAI_API_KEY=sk-your-key-here
GROQ_API_KEY=gsk_your_key_here
ZENMUX_API_KEY=your-zenmux-key-here
KIRA_API_KEY=your-kira-key-here
# Quiz mode defaults to live. Mock is development-only and never calls an LLM.
QUIZ_AI_MODE=live

# Optional: use a separate provider/quota for Quizer + Verifier only.
# Provider-specific keys are preferred over the generic QUIZ_AI_API_KEY.
# When omitted, quiz falls back to AI_PROVIDER/AI_MODEL exactly as before.
# QUIZ_AI_PROVIDER=kira
# QUIZ_AI_MODEL=kira-mini-1.0
# Provider-specific alternatives: QUIZ_GROQ_API_KEY, QUIZ_ZENMUX_API_KEY,
# QUIZ_KIRA_API_KEY or QUIZ_OPENAI_API_KEY.
# QUIZ_AI_API_KEY=generic-legacy-fallback-only

# Optional: one bounded live fallback. It is tried only after the primary
# Quizer/Verifier pipeline fails; it never loops back to the primary.
# QUIZ_AI_FALLBACK_PROVIDER=groq
# QUIZ_AI_FALLBACK_MODEL=qwen/qwen3.6-27b
# QUIZ_AI_FALLBACK_API_KEY=optional-fallback-key

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Phase 1 adaptive quiz is off by default to protect the current learning flow.
VITE_ADAPTIVE_QUIZ_ENABLED=false
ADAPTIVE_QUIZ_ENABLED=false
# Test trigger remains 30s. For a real pilot use 300-480s.
VITE_ADAPTIVE_QUIZ_TRIGGER_SECONDS=30
# Keep client/server completion cooldown aligned. Set both to 0 only for mock UI tests.
VITE_ADAPTIVE_QUIZ_COMPLETION_COOLDOWN_SECONDS=600
ADAPTIVE_QUIZ_COMPLETION_COOLDOWN_SECONDS=600
ADAPTIVE_QUIZ_MAX_PER_LESSON_24H=3
# Required only when adaptive quiz is enabled. Never expose this key with VITE_.
SUPABASE_SECRET_KEY=sb_secret_your_server_key_here
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
